  },
  "dependencies": {
    "@remotion/cli": "4.0.499",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.499"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
