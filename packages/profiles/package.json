{
  "name": "@turboflux/profiles",
  "version": "1.0.1",
  "description": "Profile isolation, archives, import, export and migration",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legacyProfileMigration": {
      "types": "./dist/legacyProfileMigration.d.ts",
      "import": "./dist/legacyProfileMigration.js"
    },
    "./legacyProfileRecoveryExport": {
      "types": "./dist/legacyProfileRecoveryExport.d.ts",
      "import": "./dist/legacyProfileRecoveryExport.js"
    },
    "./profileArchive/archiveCrypto": {
      "types": "./dist/profileArchive/archiveCrypto.d.ts",
      "import": "./dist/profileArchive/archiveCrypto.js"
    },
    "./profileArchive/archivePath": {
      "types": "./dist/profileArchive/archivePath.d.ts",
      "import": "./dist/profileArchive/archivePath.js"
    },
    "./profileArchive/archiveScanner": {
      "types": "./dist/profileArchive/archiveScanner.d.ts",
      "import": "./dist/profileArchive/archiveScanner.js"
    },
    "./profileArchive/blobStore": {
      "types": "./dist/profileArchive/blobStore.d.ts",
      "import": "./dist/profileArchive/blobStore.js"
    },
    "./profileArchive/canonicalJson": {
      "types": "./dist/profileArchive/canonicalJson.d.ts",
      "import": "./dist/profileArchive/canonicalJson.js"
    },
    "./profileArchive/componentMigrations": {
      "types": "./dist/profileArchive/componentMigrations.d.ts",
      "import": "./dist/profileArchive/componentMigrations.js"
    },
    "./profileArchive/container": {
      "types": "./dist/profileArchive/container.d.ts",
      "import": "./dist/profileArchive/container.js"
    },
    "./profileArchive/exportComponents": {
      "types": "./dist/profileArchive/exportComponents.d.ts",
      "import": "./dist/profileArchive/exportComponents.js"
    },
    "./profileArchive/exportPlanner": {
      "types": "./dist/profileArchive/exportPlanner.d.ts",
      "import": "./dist/profileArchive/exportPlanner.js"
    },
    "./profileArchive/index": {
      "types": "./dist/profileArchive/index.d.ts",
      "import": "./dist/profileArchive/index.js"
    },
    "./profileArchive/manifest": {
      "types": "./dist/profileArchive/manifest.d.ts",
      "import": "./dist/profileArchive/manifest.js"
    },
    "./profileArchive/profileArchiveImporter": {
      "types": "./dist/profileArchive/profileArchiveImporter.d.ts",
      "import": "./dist/profileArchive/profileArchiveImporter.js"
