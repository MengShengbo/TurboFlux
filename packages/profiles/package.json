    "./profileArchive/redaction": {
      "types": "./dist/profileArchive/redaction.d.ts",
      "import": "./dist/profileArchive/redaction.js"
    },
    "./profileArchive/types": {
      "types": "./dist/profileArchive/types.d.ts",
      "import": "./dist/profileArchive/types.js"
    },
    "./profileFeatureFlags": {
      "types": "./dist/profileFeatureFlags.d.ts",
      "import": "./dist/profileFeatureFlags.js"
    },
    "./profileLifecycleCoordinator": {
      "types": "./dist/profileLifecycleCoordinator.d.ts",
      "import": "./dist/profileLifecycleCoordinator.js"
    },
    "./profileRegistry": {
      "types": "./dist/profileRegistry.d.ts",
      "import": "./dist/profileRegistry.js"
    },
    "./profileSettingsCopyService": {
      "types": "./dist/profileSettingsCopyService.d.ts",
      "import": "./dist/profileSettingsCopyService.js"
    },
    "./profileStorageLayout": {
      "types": "./dist/profileStorageLayout.d.ts",
      "import": "./dist/profileStorageLayout.js"
    },
    "./profileWorkspaceRebindService": {
      "types": "./dist/profileWorkspaceRebindService.d.ts",
      "import": "./dist/profileWorkspaceRebindService.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./workspaceBindingService": {
      "types": "./dist/workspaceBindingService.d.ts",
      "import": "./dist/workspaceBindingService.js"
    },
    "./workspaceOverlayMigration": {
      "types": "./dist/workspaceOverlayMigration.d.ts",
      "import": "./dist/workspaceOverlayMigration.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node ../../scripts/fix-dist-imports.mjs dist",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@turboflux/conversations": "*",
    "@turboflux/platform": "*"
  }
}
