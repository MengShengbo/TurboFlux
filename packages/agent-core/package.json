{
  "name": "@turboflux/agent-core",
  "version": "1.0.1",
  "description": "Compatibility entrypoints for the TurboFlux package ecosystem; new consumers use domain packages",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js"
    },
    "./contracts": {
      "types": "./dist/kernel/contracts.d.ts",
      "import": "./dist/kernel/contracts.js"
    },
    "./runtime": {
      "types": "./dist/kernel/runtime.d.ts",
      "import": "./dist/kernel/runtime.js"
    },
    "./renderer": {
      "types": "./dist/kernel/renderer.d.ts",
      "import": "./dist/kernel/renderer.js"
    },
    "./workbench": {
      "types": "./dist/kernel/workbench.d.ts",
      "import": "./dist/kernel/workbench.js"
    },
    "./extensions": {
      "types": "./dist/kernel/extensions.d.ts",
      "import": "./dist/kernel/extensions.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node ../../scripts/fix-dist-imports.mjs dist",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@turboflux/agent-runtime": "*",
    "@turboflux/contracts": "*",
    "@turboflux/conversations": "*",
    "@turboflux/extensions": "*",
    "@turboflux/presentation": "*",
    "@turboflux/workbench": "*",
    "@turboflux/models": "*",
    "@turboflux/platform": "*",
    "@turboflux/tools": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
