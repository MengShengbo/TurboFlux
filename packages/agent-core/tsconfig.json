{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": [
    "src/kernel/**/*",
    "src/application/**/*",
    "src/core/**/*",
    "src/platform/**/*",
    "src/shared/**/*",
    "src/state/**/*",
    "src/tools/**/*"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../dist-desktop",
    "src/desktop/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
